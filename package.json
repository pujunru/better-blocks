{
  "name": "better-blocks",
  "version": "0.1.0",
  "description": "Obsidian code blocks that render as clean, good-looking diagrams.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "preview": "node dev/build-preview.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": ["obsidian", "obsidian-plugin", "diagram", "flowchart", "process"],
  "author": "Junru Pu",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0"
  }
}
